# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit
# real credentials.

# The Gmail account that sends the contact-form mail.
GMAIL_USER=you@gmail.com

# A Google App Password (16 characters), NOT your normal account password.
# Requires 2-Step Verification on the account, then:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Google shows it as four spaced groups; pasting it with or without spaces works.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional. Where enquiries are delivered. Defaults to GMAIL_USER.
# CONTACT_TO=you@gmail.com

# --- Admin panel (Supabase Auth) --------------------------------------------
# Sign-in at /admin/login is Supabase Auth. The operator account lives in
# Supabase (Dashboard -> Authentication -> Users), NOT in this file — there is
# no admin email, password or session secret to configure here any more.
#
# To add or reset an operator: Dashboard -> Authentication -> Users -> Add user
# (or "Send password recovery"). To confirm a sign-in works from the terminal:
#   npm run verify:supabase-login
#
# The three Supabase variables below are all the admin panel needs.

# --- Supabase (auth + pricing + media storage) ------------------------------
# Backs admin sign-in, the Pricing Manager and the User Interface Manager.
# Create a project at supabase.com, then in the SQL Editor run
# `supabase/schema.sql` followed by `supabase/auth-migration.sql`, and create a
# public bucket named `media`.
#
# Project URL and anon key, from Project Settings -> API. Both are shipped to
# the browser by the NEXT_PUBLIC_ prefix, which is safe: anon may only read.
# Writes are authorised by RLS against the signed-in admin's own session, so
# the anon key on its own can never change anything.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, and no longer used by the running app — writes go through the
# admin's session instead. Kept for the one-off `npm run migrate:supabase`
# script, which seeds tables before any operator account exists. It bypasses
# RLS, so never give it a NEXT_PUBLIC_ prefix and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate-limit store (Upstash Redis / Vercel KV) ---------------------------
# Where the contact-form and admin-login rate limits keep their state
# (src/lib/rate-limit.ts). Leave both blank locally: the limiter falls back to
# an in-memory map, which is correct for a single process.
#
# In production on serverless (Vercel), set them — otherwise each function
# instance counts attempts on its own and a cold start hands out a fresh
# budget. Create a Redis database at upstash.com (or add Upstash from the
# Vercel Marketplace, which injects KV_REST_API_URL / KV_REST_API_TOKEN and is
# read here too), then copy the REST URL and REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
